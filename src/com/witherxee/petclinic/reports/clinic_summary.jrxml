      <text><![CDATA[Method]]></text>
    </element>
  </columnHeader>
  <detail>
    <band height="30">
    <element kind="textField" x="0" y="0" width="65" height="28" fontSize="8.0" blankWhenNull="true" textAdjust="StretchHeight">
      <expression><![CDATA[$F{appointment_id}]]></expression>
    </element>
    <element kind="textField" x="65" y="0" width="90" height="28" fontSize="8.0" blankWhenNull="true" textAdjust="StretchHeight">
      <expression><![CDATA[$F{customer_name}]]></expression>
    </element>
    <element kind="textField" x="155" y="0" width="80" height="28" fontSize="8.0" blankWhenNull="true" textAdjust="StretchHeight">
      <expression><![CDATA[$F{pet_name}]]></expression>
    </element>
    <element kind="textField" x="235" y="0" width="90" height="28" fontSize="8.0" blankWhenNull="true" textAdjust="StretchHeight">
      <expression><![CDATA[$F{veterinarian_name}]]></expression>
    </element>
    <element kind="textField" x="325" y="0" width="100" height="28" fontSize="8.0" blankWhenNull="true" textAdjust="StretchHeight">
      <expression><![CDATA[($F{appointment_date}==null?"":new java.text.SimpleDateFormat("yyyy-MM-dd").format($F{appointment_date}))+" "+($F{appointment_time}==null?"":new java.text.SimpleDateFormat("HH:mm").format($F{appointment_time}))]]></expression>
    </element>
    <element kind="textField" x="425" y="0" width="115" height="28" fontSize="8.0" blankWhenNull="true" textAdjust="StretchHeight">
      <expression><![CDATA[$F{treatment_description}]]></expression>
